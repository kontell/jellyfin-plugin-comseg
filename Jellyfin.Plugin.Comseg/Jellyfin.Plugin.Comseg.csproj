<Project Sdk="Microsoft.NET.Sdk">

  <!-- Jellyfin 12 only. What a build is pinned to is a property with a default
       here, so the build matrix (.github/workflows/abis.yml) can pass the same
       values and a bare local build gets the supported line. -->
  <PropertyGroup>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0.0</JellyfinVersion>
    <!-- Deliberately NOT overridden as TargetFramework: MSBuild strips a global
         TargetFramework before restore, so -p:TargetFramework restores the
         packages against the default here and NU1202s. A custom property
         survives restore and then sets the real one. -->
    <JellyfinFramework Condition="'$(JellyfinFramework)' == ''">net10.0</JellyfinFramework>
    <TargetFramework>$(JellyfinFramework)</TargetFramework>
    <!-- <server major.minor>.0.<build>: Jellyfin treats targetAbi as a floor
         (jellyfin#11331), so the version says which line a zip is for. -->
    <PluginVersion Condition="'$(PluginVersion)' == ''">12.0.0.1</PluginVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
    <FileVersion>$(PluginVersion)</FileVersion>
    <RootNamespace>Jellyfin.Plugin.Comseg</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Comskip\comskip.ini" />
    <EmbeddedResource Include="Comskip\comskip.ini" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pin to the OLDEST supported patch of the line, and do NOT float:
         .NET binds an assembly reference upward but never downward. -->
    <PackageReference Include="Jellyfin.Controller" Version="[$(JellyfinVersion)]" />
    <PackageReference Include="Jellyfin.Data" Version="[$(JellyfinVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Comseg.Tests" />
  </ItemGroup>

</Project>
