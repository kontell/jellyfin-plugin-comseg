@@ -3408,6 +3417,34 @@
     {
         BuildCommListAsYouGo();
     }
+#if !defined(_WIN32)
+    if (live_tv && live_master_interval > 0 && frame_count - live_master_last_frame > live_master_interval * fps)
+    {
+        live_master_last_frame = frame_count;
+        while (waitpid(-1, NULL, WNOHANG) > 0) { }
+        fflush(NULL);
+        if (fork() == 0)
+        {
+            // Child: BuildMasterCommList() reopens every output file from outbasename
+            // (OpenOutputFiles), so give the child its own base name and publish the
+            // finished .edl with an atomic rename. The parent's state is untouched.
+            char tmpname[MAX_PATH + 32];
+            char finalname[MAX_PATH + 32];
+            sprintf(finalname, "%s.master.edl", outbasename);
+            strncat(outbasename, ".master.tmp", MAX_PATH - strlen(outbasename) - 1);
+            sprintf(tmpname, "%s.edl", outbasename);
+            framenum_real = frame_count;
+            framesprocessed = frame_count;
+            output_default = false;
+            output_live = false;
+            output_edl = true;
+            verbose = 0;
+            BuildMasterCommList();
+            rename(tmpname, finalname);
+            _exit(0);
+        }
+    }
+#endif
 
     return 0;
 }
